{
  "name": "frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "frontend/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec next dev -p 3001", "cwd": "frontend" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec next build", "cwd": "frontend" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec next start -p 3001", "cwd": "frontend" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vitest run", "cwd": "frontend" }
    },
    "check-types": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --pretty --noEmit", "cwd": "frontend" }
    }
  }
}
