# Production compose environment. Copy to .env on the host and fill real values.
# Never commit .env or registry/SSH credentials.
#
# TLS is terminated by the external proxy. Caddy listens on plain HTTP only
# (auto_https off in the baked Caddyfile.template) and is published on CADDY_PORT.
# Optional variables are commented out: uncomment to override the shown default.

# --- Required: validated by scripts/deploy-remote.sh ------------------------

# Password used by both the Redis server (--requirepass) and the backend client.
# Avoid whitespace and shell metacharacters: the compose command is unquoted.
REDIS_PASSWORD=change-me

# Site address rendered by Caddy as <SERVICE_SUBDOMAIN>.<COMMON_DOMAIN>.
COMMON_DOMAIN=example.test
SERVICE_SUBDOMAIN=api.badges
FRONTEND_SUBDOMAIN=badges

# Image references pulled on the host. Override to pin a sha-<short> tag.
BACKEND_IMAGE=ghcr.io/ashenhermit/hermit-badges-generator/backend:latest
FRONTEND_IMAGE=ghcr.io/ashenhermit/hermit-badges-generator/frontend:latest
CADDY_IMAGE=ghcr.io/ashenhermit/hermit-badges-generator/caddy:latest

# --- Optional: host port and backend process settings -----------------------

# Host port mapped to Caddy's container port 80.
# CADDY_PORT=8080

# Set explicitly by docker-compose.prod.yml in production; shown for reference.
# NODE_ENV=production
# PORT=3000
# CACHE_DRIVER=redis              # memory|redis
# CACHE_TTL_MS=3600000            # milliseconds; Redis TTL = ceil(ms / 1000)
# CACHE_MAX_ENTRIES=1000          # memory driver only

# Cache bypass flags. Accepted truthy values: 1, true, yes (case-insensitive).
# CACHE_DISABLED=false            # no reads/writes, render every request
# FRESH_TEMPLATE=false            # re-read template.html on every generation
# FRESH_MANIFEST=false            # deprecated alias of FRESH_TEMPLATE

# --- Optional: Redis client -------------------------------------------------

# Compose overrides these with the service name and its internal port.
# REDIS_HOST=redis                # source default: 127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# --- Optional: Caddy upstream -----------------------------------------------

# Baked into the Caddy image and set by compose; shown for reference.
# BACKEND_HOST=backend
# BACKEND_PORT=3000

# --- Optional: frontend -----------------------------------------------------

# Compose sets these; shown for reference. Caddy proxies non-/api requests to
# the frontend service on the internal badge-generator network.
# FRONTEND_HOST=frontend
# FRONTEND_PORT=3000

# Runtime base for Next.js server-side /api rewrites inside the frontend
# container. Browser requests to /api/* are routed by Caddy straight to backend.
# API_PROXY_TARGET=http://backend:3000

# Build-time public API origin baked into client JS (preview and copied links).
# Dockerfile build arg; the workflow passes the repository variable of the same
# name, defaulting to the production API host.
# NEXT_PUBLIC_API_BASE_URL=https://api.badges.ashen-hermit.space

# --- CI-only: GitHub Actions workflow inputs/secrets, not for host .env -----

# SSH_HOST=158.255.6.45
# SSH_USER=root
# SSH_PORT=22
# SSH_PRIVATE_KEY=
# DEPLOY_PATH=/home/hermit-badges-generator
# COMPOSE_FILE=docker-compose.prod.yml
# PROD_ENV=
# GHCR_USER=
# GHCR_TOKEN=
# GITHUB_TOKEN=
# REF=master
# DRY_RUN=0
# DEPLOY_SOURCE_ONLY=0
