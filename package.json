{
  "name": "badge-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Badge generator service for frame-based SVG badges",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start",
    "assets:build": "node scripts/check-assets.mjs",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "class-transformer": "^0.5",
    "class-validator": "^0.15",
    "playwright-core": "1.65.1",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/supertest": "^6",
    "jest": "^29",
    "supertest": "^7",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}
