# Local development defaults for the badge generator backend.
# Copy to backend/.env and adjust as needed. Never commit the real .env.
PORT=3000
CACHE_DRIVER=memory
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=1000
CACHE_DISABLED=false
FRESH_TEMPLATE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
